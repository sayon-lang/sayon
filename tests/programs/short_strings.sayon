##
Strings of every length around the 23 bytes that fit inside a string,
built every way, then compared, copied, viewed, measured, sorted, and used
as keys.
##

collections = import("standard/collections.sayon")
strings = import("standard/strings.sayon")

function main()
    built = ""
    lengths: Array<integer> = []
    for i in range(30)
        built += "{i % 10}"
        push(lengths, bytelength(built))
    print(lengths)
    print(built, length(built), bytelength(built))
    # Around the boundary: 22, 23, and 24 bytes.
    for size in [22, 23, 24]
        text = strings.repeat("ab", size / 2) + strings.repeat("c", size % 2)
        same = clone(text)
        other = text + ""
        print(size, bytelength(text), text == same, text == other, strings.slice(text, 1, 4), strings.byte_view(text, 20, bytelength(text)))
    # Text among the constants and text put together compare equal.
    constant_text = "hello"
    made = "hel" + "lo"
    print(constant_text == made, made < "help", made > "hell")
    # Characters of several bytes.
    accented = "é" + "ö" + "ü"
    print(accented, length(accented), bytelength(accented))
    # Keys of a dictionary.
    counts: Dict<string, integer> = []
    for word in strings.split("a bb ccc a bb dddddddddddddddddddddddddd a", " ")
        if haskey(counts, word)
            counts[word] += 1
        else
            counts[word] = 1
    print(counts)
    # Short and long strings sorted together.
    words = ["pear", "a much longer string than fits inside", "fig", "apple", "zz", "a much longer string than fits inside!"]
    collections.sort(words)
    print(words)
    # Interpolation, short and long.
    name = "Ada"
    print("hi {name}!", "a longer greeting for {name}, which goes past twenty-three bytes")
    # Joining short pieces into long text, and splitting it again.
    pieces: Array<string> = []
    for i in range(12)
        push(pieces, "p{i}")
    joined = strings.join(pieces, ",")
    print(joined, bytelength(joined), length(strings.split(joined, ",")))
    # A string added to itself, short and long.
    twice = "abc"
    twice = twice + twice
    twice += twice
    print(twice, bytelength(twice))
    for character in "héllo"
        print(character, bytelength(character))
    # Views of the bytes of short and long text.
    short = "sh" + "ort"
    long = "a string longer than " + "twenty-three bytes"
    print(strings.byte_view(short, 1, 3), strings.byte_view(long, 30, 34))
