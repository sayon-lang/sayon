##
Hashing, signing, passwords, and secure random bytes: SHA-256 digests,
HMAC-SHA256 codes, passwords kept as PBKDF2 hashes, and bytes from the
system's secure source, fit for keys and tokens, unlike `math.random`.

    crypto = import("standard/crypto.sayon")
    strings = import("standard/strings.sayon")
    print(crypto.hex(crypto.sha256(strings.bytes("abc"))))
    token = crypto.hex(crypto.random_bytes(32))
    kept = crypto.hash_password("correct horse battery staple")
    print(crypto.check_password("correct horse battery staple", kept))
##

strings = import("standard/strings.sayon")

private constant DIGITS = "0123456789abcdef"

##
How many rounds `hash_password` takes: what OWASP advises for PBKDF2 with
HMAC-SHA256.
##
private constant PASSWORD_ROUNDS = 600000

# The most rounds `check_password` takes, as `pbkdf2_sha256` allows.
private constant MOST_ROUNDS = 10000000

# The SHA-256 digest of bytes (FIPS 180-4): 32 bytes.
function sha256(data: Array<byte>) -> Array<byte>
    return host_sha256(data)

##
The HMAC-SHA256 code of a message under a key (RFC 2104): 32 bytes that
only someone with the key could make, for telling that a message, such as
a cookie, is one you made. Compare codes with `same`.
##
function hmac_sha256(key: Array<byte>, message: Array<byte>) -> Array<byte>
    return host_hmac_sha256(key, message)

##
PBKDF2 with HMAC-SHA256 (RFC 8018): `length` bytes derived from a password
and a salt by `rounds` rounds of HMAC-SHA256, slow on purpose, so that
guessing passwords is slow too. Rounds are 1 to 10,000,000 and the length
1 to 1,024 bytes; others raise `ValueError`. `hash_password` chooses them
for keeping passwords.
##
function pbkdf2_sha256(password: Array<byte>, salt: Array<byte>, rounds: integer, length: integer) -> Array<byte>
    return host_pbkdf2_sha256(password, salt, rounds, length)

##
A password made safe to keep: `pbkdf2-sha256$<rounds>$<salt>$<hash>`, from
600,000 rounds of PBKDF2 and a new random salt, so that the same password
never gives the same text twice. It takes a moment, on purpose.
`check_password` tells whether a password is the one it was made from.
##
function hash_password(password: string) -> string
    salt = hex(random_bytes(16))
    derived = pbkdf2_sha256(strings.bytes(password), strings.bytes(salt), PASSWORD_ROUNDS, 32)
    return "pbkdf2-sha256${PASSWORD_ROUNDS}${salt}${hex(derived)}"

##
Whether `password` is the one `hash_password` made `kept` from, comparing
the hashes in constant time; false for text `hash_password` does not make.
##
function check_password(password: string, kept: string) -> boolean
    parts = strings.split(kept, "$")
    if length(parts) != 4 or parts[0] != "pbkdf2-sha256" or parts[2] == "" or length(parts[3]) != 64
        return false
    rounds = try strings.parse_integer(parts[1])
    if rounds is error
        return false
    if rounds < 1 or rounds > MOST_ROUNDS
        return false
    derived = pbkdf2_sha256(strings.bytes(password), strings.bytes(parts[2]), rounds, 32)
    return same(strings.bytes(hex(derived)), strings.bytes(parts[3]))

##
`count` bytes from the system's secure random source, 1 MiB at most at a
time; a negative or larger count raises `ValueError`.
##
function random_bytes(count: integer) -> Array<byte>
    return host_random_bytes(count)

# Bytes as lowercase hexadecimal, two digits for each.
function hex(data: Array<byte>) -> string
    digits: Array<string> = []
    for value in data
        number = integer(value)
        push(digits, DIGITS[number / 16])
        push(digits, DIGITS[number % 16])
    return strings.join(digits, "")

##
Whether two byte arrays are equal, looking at every byte rather than
stopping at the first that differs, for comparing secrets such as tokens.
##
function same(first: Array<byte>, second: Array<byte>) -> boolean
    if length(first) != length(second)
        return false
    differences = 0
    for index in range(length(first))
        if first[index] != second[index]
            differences += 1
    return differences == 0
