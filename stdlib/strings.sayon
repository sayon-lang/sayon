##
Operations on text. Positions and lengths count Unicode characters (code
points); `graphemes` works with what readers see as characters, and
`bytes` with the UTF-8 encoding.

    strings = import("standard/strings.sayon")
    words = strings.split("a,b,c", ",")
##

# Splits text at every occurrence of a non-empty separator.
function split(text: string, separator: string) -> Array<string>
    return host_split(text, separator)

# The lines of a text, accepting LF and CRLF line endings.
function lines(text: string) -> Array<string>
    return host_split_lines(text)

# Joins parts with a separator between them.
function join(parts: Array<string>, separator: string) -> string
    return host_join(parts, separator)

##
The text without leading and trailing whitespace: the characters Unicode
calls white space, such as spaces, tabs, and line breaks.
##
function trim(text: string) -> string
    return host_trim(text)

# The text without leading whitespace.
function trim_start(text: string) -> string
    return host_trim_start(text)

# The text without trailing whitespace.
function trim_end(text: string) -> string
    return host_trim_end(text)

# The text in uppercase, by Unicode's rules for any language: `ß` becomes `SS`.
function upper(text: string) -> string
    return host_upper(text)

# The text in lowercase, by Unicode's rules for any language.
function lower(text: string) -> string
    return host_lower(text)

# Replaces every occurrence of a non-empty piece of text.
function replace(text: string, from: string, to: string) -> string
    return host_replace(text, from, to)

# Whether the text begins with `prefix`.
function starts_with(text: string, prefix: string) -> boolean
    return host_starts_with(text, prefix)

# Whether the text ends with `suffix`.
function ends_with(text: string, suffix: string) -> boolean
    return host_ends_with(text, suffix)

# Whether `part` occurs anywhere in the text.
function contains(text: string, part: string) -> boolean
    return host_contains(text, part)

# The position of the first occurrence of `part`, or nothing.
function find(text: string, part: string) -> integer or nothing
    position = host_find(text, part)
    if position < 0
        return nothing
    return position

# The text repeated `count` times.
function repeat(text: string, count: integer) -> string
    return host_repeat(text, count)

##
The text with `fill`, one character, put before it until it is `width`
characters long: `pad_start("7", 3, "0")` is "007". Longer text stays as
it is.
##
function pad_start(text: string, width: integer, fill = " ") -> string
    return padding(text, width, fill) + text

##
The text with `fill`, one character, put after it until it is `width`
characters long: `pad_end("ab", 4)` is "ab  ". Longer text stays as it is.
##
function pad_end(text: string, width: integer, fill = " ") -> string
    return text + padding(text, width, fill)

# The characters from `start` up to, but not including, `end`.
function slice(text: string, start: integer, end: integer) -> string
    return host_substring(text, start, end)

# Each character as a one-character string.
function characters(text: string) -> Array<string>
    return host_characters(text)

##
The user-perceived characters of a text, its extended grapheme clusters:
a letter with its accents, a whole emoji sequence, or a flag is one, so
`graphemes("e\u{301}")` is ["é"] while `characters` gives two strings.
The rules are those of Unicode 17.0.
##
function graphemes(text: string) -> Array<string>
    return host_graphemes(text)

# The number of user-perceived characters, as `graphemes` finds them.
function grapheme_count(text: string) -> integer
    return host_grapheme_count(text)

# The text's UTF-8 encoding; `bytelength(text)` is its length.
function bytes(text: string) -> Array<byte>
    return host_bytes(text)

##
The UTF-8 bytes of a text from `start` up to, but not including, `end`,
without copying them. The view borrows the text for as long as it is used.
##
function byte_view(text: string, start = 0, end = bytelength(text)) -> View<byte>
    return view(text, start, end)

##
The text that UTF-8 bytes encode. Fails with EncodingError when they are
not valid UTF-8.
##
function from_bytes(bytes: Array<byte>) -> string
    return host_from_bytes(bytes)

##
The text that UTF-8 bytes encode, with U+FFFD, the replacement character,
in place of each invalid sequence.
##
function from_bytes_lossy(bytes: Array<byte>) -> string
    return host_from_bytes_lossy(bytes)

##
Text in an encoding: "utf-8", "utf-16" (little-endian after a byte-order
mark), "utf-16le", "utf-16be", "latin-1", "ascii", or "windows-1252".
Fails with EncodingError for a character the encoding has no form for.
##
function encode(text: string, encoding: string) -> Array<byte>
    return host_encode(text, encoding)

##
Bytes of an encoding as text; "utf-16" follows a byte-order mark, and is
little-endian without one. Fails with EncodingError for bytes that are not
valid in the encoding.
##
function decode(bytes: Array<byte>, encoding: string) -> string
    return host_decode(bytes, encoding)

##
Bytes of an encoding as text, with U+FFFD for the bytes that are not
valid in it.
##
function decode_lossy(bytes: Array<byte>, encoding: string) -> string
    return host_decode_lossy(bytes, encoding)

# The Unicode code of a one-character string, such as 65 for "A".
function code(character: string) -> integer
    return host_code(character)

# The one-character string with a Unicode code, such as "A" for 65.
function character(code: integer) -> string
    return host_character(code)

##
The integer that `text` writes in `base`, from 2 to 36: an optional `+` or
`-`, then digits, which from 10 on are the letters `a` to `z` in either
case. `parse_integer("ff", 16)` is 255, and `parse_integer("-101", 2)` is
-5. Fails with ParseError for other text, and for a number that does not
fit in an integer.
##
function parse_integer(text: string, base = 10) -> integer
    if base < 2 or base > 36
        host_value_fail("a base is from 2 to 36, not {base}")
    start = 0
    if starts_with(text, "-") or starts_with(text, "+")
        start = 1
    negative = starts_with(text, "-")
    if length(text) == start
        host_parse_error("\"{text}\" is not an integer")
    value = 0
    for character in slice(text, start, length(text))
        digit = digit_value(character)
        if digit >= base
            host_parse_error("\"{text}\" is not an integer in base {base}")
        ##
        A negative number is built on the negative side, which reaches one
        further than the positive.
        ##
        if negative
            if value < (-9223372036854775807 - 1 + digit) / base
                host_parse_error("\"{text}\" does not fit in an integer")
            value = value * base - digit
        elseif value > (9223372036854775807 - digit) / base
            host_parse_error("\"{text}\" does not fit in an integer")
        else
            value = value * base + digit
    return value

##
The number written with `places` digits after the decimal point, from 0 to
100, rounded to the nearest: `decimal(3.14159, 2)` is "3.14". A tie goes
to the even digit, and since the float nearest a decimal is a little more
or less than it, `decimal(2.675, 2)` is "2.67". NaN and the infinities are
written as `tostring` writes them.
##
function decimal(value: float, places: integer) -> string
    return host_decimal_text(value, places)

# What `pad_start` and `pad_end` put beside the text.
private function padding(text: string, width: integer, fill: string) -> string
    if length(fill) != 1
        host_value_fail("padding is one character, not \"{fill}\"")
    if length(text) >= width
        return ""
    return repeat(fill, width - length(text))

##
A digit's value: 0 to 9 for `0` to `9`, and 10 to 35 for the letters `a`
to `z` in either case; 36, a digit of no base, for any other character.
##
private function digit_value(character: string) -> integer
    if character >= "0" and character <= "9"
        return code(character) - code("0")
    if character >= "a" and character <= "z"
        return code(character) - code("a") + 10
    if character >= "A" and character <= "Z"
        return code(character) - code("A") + 10
    return 36
