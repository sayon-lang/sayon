# Sieve: count the primes below a limit with the sieve of Eratosthenes,
# one byte for each number. A long walk through memory in simple steps.

os = import("standard/os.sayon")
strings = import("standard/strings.sayon")

function main()
    limit = 1000000
    arguments = os.arguments()
    if length(arguments) > 0
        limit = strings.parse_integer(arguments[0])
    composite: Array<boolean> = []
    for _n in range(limit)
        push(composite, false)
    count = 0
    last = 0
    for n in range(2, limit)
        if composite[n]
            continue
        count += 1
        last = n
        multiple = n * n
        while multiple < limit
            composite[multiple] = true
            multiple += n
    print(count, last)
