# Runs the benchmarks. Each program is built in C++, Rust, and Sayon, the way
# each language builds for release, and run with the same input. The first
# run of each checks that all three print the same thing; then they take
# turns, several runs each, and the median processor time and peak memory
# of each go into results.md.
#
#     sayon run run.sayon                    all of them, 5 runs each
#     sayon run run.sayon -- nbody sort      only these
#     sayon run run.sayon -- --runs 9
#
# Run it from this folder. It needs clang++ and rustc on the path. It uses
# the sayon on the path too, unless SAYON names another one.

collections = import("standard/collections.sayon")
filesystem = import("standard/filesystem.sayon")
io = import("standard/io.sayon")
os = import("standard/os.sayon")
strings = import("standard/strings.sayon")
time = import("standard/time.sayon")

# A benchmark, and the input it gets.
type Benchmark = [name: string, input: string]

# One language's build of a benchmark.
type Build = [language: string, program: string]

# What a build's runs measured: processor time in nanoseconds, and peak
# memory in bytes.
type Measured = [times: Array<integer>, memory: Array<integer>]

# One row of the results.
type Row = [benchmark: Benchmark, measured: Array<Measured>]

constant LANGUAGES = ["C++", "Rust", "Sayon"]

function all_benchmarks() -> Array<Benchmark>
    return [
        Benchmark(name = "fannkuch", input = "10"),
        Benchmark(name = "nbody", input = "2000000"),
        Benchmark(name = "spectral_norm", input = "1500"),
        Benchmark(name = "mandelbrot", input = "2000"),
        Benchmark(name = "binary_trees", input = "15"),
        Benchmark(name = "word_count", input = "2000000"),
        Benchmark(name = "sort", input = "3000000"),
        Benchmark(name = "text", input = "1000000")
    ]

# The name of a program file on this system.
function executable(path: string) -> string
    if os.platform() == "windows"
        return "{path}.exe"
    return clone(path)

# Runs a program that must succeed, and gives what it printed.
function must_run(program: string, arguments: Array<string>) -> string
    result = os.run(program, arguments)
    if result.status != 0
        command = strings.join(arguments, " ")
        error("`{program} {command}` failed with status {result.status}:\n{result.errors}{result.output}")
    return clone(result.output)

# The first line a program prints, such as its version.
function first_line(program: string, arguments: Array<string>) -> string
    lines = strings.lines(must_run(program, arguments))
    if length(lines) == 0
        return clone(program)
    return strings.trim(lines[0])

function build(benchmark: Benchmark, sayon: string, folder: string) -> Array<Build>
    name = clone(benchmark.name)
    source = filesystem.join(name, name)
    out = filesystem.join(folder, name)
    cpp = executable("{out}-cpp")
    rust = executable("{out}-rust")
    native = executable("{out}-sayon")
    must_run("clang++", ["-O2", "-std=c++20", "{source}.cpp", "-o", clone(cpp)])
    must_run("rustc", ["-C", "opt-level=3", "-o", clone(rust), "{source}.rs"])
    must_run(sayon, ["build", "--release", "-q", "{source}.sayon", "-o", clone(native)])
    return [
        Build(language = "C++", program = cpp),
        Build(language = "Rust", program = rust),
        Build(language = "Sayon", program = native)
    ]

# Runs each build once, which also brings the programs into the disk cache
# and past any virus scan of a new file, and fails unless all three print
# the same.
function check(benchmark: Benchmark, builds: Array<Build>)
    expected = ""
    for build in builds
        output = strings.replace(must_run(build.program, [clone(benchmark.input)]), "\r\n", "\n")
        if build.language == "C++"
            expected = output
        elseif output != expected
            error("{benchmark.name} in {build.language} printed\n{output}\nbut in C++\n{expected}")

# The builds take turns, so that whatever else the computer does at the
# time falls on all of them alike.
function measure(benchmark: Benchmark, builds: Array<Build>, runs: integer) -> Array<Measured>
    results: Array<Measured> = []
    for _build in builds
        times: Array<integer> = []
        memory: Array<integer> = []
        push(results, Measured(times = times, memory = memory))
    for _round in range(runs)
        for index in range(length(builds))
            done = os.run(builds[index].program, [clone(benchmark.input)])
            if done.status != 0
                error("{benchmark.name} in {builds[index].language} failed with status {done.status}")
            push(results[index].times, done.usage.processor_time.nanoseconds)
            push(results[index].memory, done.usage.peak_memory)
    return results

function median(values: Array<integer>) -> integer
    sorted = clone(values)
    collections.sort(sorted)
    return sorted[length(sorted) / 2]

function seconds(nanoseconds: integer) -> string
    return "{strings.decimal(float(nanoseconds) / 1000000000.0, 2)} s"

function megabytes(bytes: integer) -> string
    return "{strings.decimal(float(bytes) / 1048576.0, 1)} MB"

# Sayon's measure against the better of C++ and Rust: below 1 is better.
function against(values: Array<integer>) -> string
    best = values[0]
    if values[1] < best
        best = values[1]
    return "{strings.decimal(float(values[2]) / float(best), 2)}×"

# A table of the medians of what `pick` takes from each build's runs.
function table(rows: Array<Row>, update pick, show) -> string
    lines = ["| Benchmark | Input | C++ | Rust | Sayon | Sayon against the better |", "|---|---:|---:|---:|---:|---:|"]
    for row in rows
        values: Array<integer> = []
        for measured in row.measured
            push(values, median(pick(measured)))
        push(lines, "| {row.benchmark.name} | {row.benchmark.input} | {show(values[0])} | {show(values[1])} | {show(values[2])} | {against(values)} |")
    return strings.join(lines, "\n")

function report(rows: Array<Row>, runs: integer, sayon: string) -> string
    processor = "this computer"
    if os.platform() == "windows"
        processor = first_line("powershell", ["-NoProfile", "-Command", "(Get-CimInstance Win32_Processor).Name"])
    elseif filesystem.exists("/proc/cpuinfo")
        for line in io.read_lines("/proc/cpuinfo")
            if strings.starts_with(line, "model name")
                parts = strings.split(line, ":")
                processor = strings.trim(parts[1])
                break
    lines = [
        "# Benchmark results",
        "",
        "Measured on {strings.split(time.format(time.now()), "T")[0]}, on {processor}, {os.platform()}.",
        "",
        "- C++: {first_line("clang++", ["--version"])}, with `-O2`",
        "- Rust: {first_line("rustc", ["--version"])}, with `-C opt-level=3`",
        "- Sayon: {first_line(sayon, ["version"])}, with `sayon build --release`",
        "",
        "Each number is the median of {runs} runs. Processor time adds up the time the program's threads ran, and the system's time on its behalf, so it barely changes with what else the computer is doing. Peak memory is the most the program held in memory at once.",
        "",
        "## Processor time",
        "",
        table(rows, function(measured: Measured) return clone(measured.times), seconds),
        "",
        "## Peak memory",
        "",
        table(rows, function(measured: Measured) return clone(measured.memory), megabytes),
        ""
    ]
    return strings.join(lines, "\n")

function main()
    runs = 5
    chosen: Array<string> = []
    arguments = os.arguments()
    position = 0
    while position < length(arguments)
        if arguments[position] == "--runs" and position + 1 < length(arguments)
            runs = strings.parse_integer(arguments[position + 1])
            position += 2
        else
            push(chosen, clone(arguments[position]))
            position += 1
    sayon = "sayon"
    named = os.environment("SAYON")
    if typeof(named) == "string"
        sayon = named
    folder = "build"
    if not filesystem.exists(folder)
        filesystem.create_directory(folder)
    rows: Array<Row> = []
    for benchmark in all_benchmarks()
        if length(chosen) > 0 and not contains(chosen, benchmark.name)
            continue
        print("{benchmark.name} ({benchmark.input})")
        builds = build(benchmark, sayon, folder)
        check(benchmark, builds)
        measured = measure(benchmark, builds, runs)
        for index in range(length(builds))
            print("  {builds[index].language}: {seconds(median(measured[index].times))}, {megabytes(median(measured[index].memory))}")
        push(rows, Row(benchmark = clone(benchmark), measured = measured))
    text = report(rows, runs, sayon)
    io.write_file("results.md", text)
    print("")
    print(text)

function contains(names: Array<string>, name: string) -> boolean
    for each in names
        if each == name
            return true
    return false
