# Runs the benchmarks. Each program is built in C++, Rust, and Sayon, the way
# each language builds for release, and run with the same input. The first
# run of each checks that all three print the same thing; then they take
# turns, several runs each. Each program's README gets a table of what its
# three versions measured, and results.md a summary of them all.
#
#     sayon run run.sayon                    all of them, 5 runs each
#     sayon run run.sayon -- nbody sort      only these
#     sayon run run.sayon -- --runs 9
#
# Run it from this folder. It needs clang++ and rustc on the path. It uses
# the sayon on the path too, unless SAYON names another one.

collections = import("standard/collections.sayon")
filesystem = import("standard/filesystem.sayon")
io = import("standard/io.sayon")
os = import("standard/os.sayon")
strings = import("standard/strings.sayon")
time = import("standard/time.sayon")

# A benchmark, and the input it gets.
type Benchmark = [name: string, input: string]

# One language's build of a benchmark.
type Build = [language: string, program: string]

# What a build's runs measured: processor time in nanoseconds and peak
# memory in bytes, for each run, and the size of its executable.
type Measured = [times: Array<integer>, memory: Array<integer>, size: integer]

# One row of the results.
type Row = [benchmark: Benchmark, measured: Array<Measured>]

# The computer and the compilers the numbers come from.
type Setting = [day: string, computer: string, cpp: string, rust: string, sayon: string]

# Where a benchmark's README holds what this writes.
constant START = "<!-- results: run.sayon writes this part -->"
constant END = "<!-- end of results -->"

function all_benchmarks() -> Array<Benchmark>
    return [
        Benchmark(name = "fannkuch", input = "10"),
        Benchmark(name = "nbody", input = "2000000"),
        Benchmark(name = "spectral_norm", input = "1500"),
        Benchmark(name = "mandelbrot", input = "2000"),
        Benchmark(name = "binary_trees", input = "15"),
        Benchmark(name = "word_count", input = "2000000"),
        Benchmark(name = "sort", input = "3000000"),
        Benchmark(name = "text", input = "1000000")
    ]

# The name of a program file on this system.
function executable(path: string) -> string
    if os.platform() == "windows"
        return "{path}.exe"
    return clone(path)

# Runs a program that must succeed, and gives what it printed.
function must_run(program: string, arguments: Array<string>) -> string
    result = os.run(program, arguments)
    if result.status != 0
        command = strings.join(arguments, " ")
        error("`{program} {command}` failed with status {result.status}:\n{result.errors}{result.output}")
    return clone(result.output)

# The first line a program prints, such as its version.
function first_line(program: string, arguments: Array<string>) -> string
    lines = strings.lines(must_run(program, arguments))
    if length(lines) == 0
        return clone(program)
    return strings.trim(lines[0])

function setting(sayon: string) -> Setting
    computer = "this computer"
    if os.platform() == "windows"
        computer = first_line("powershell", ["-NoProfile", "-Command", "(Get-CimInstance Win32_Processor).Name"])
    elseif filesystem.exists("/proc/cpuinfo")
        for line in io.read_lines("/proc/cpuinfo")
            if strings.starts_with(line, "model name")
                parts = strings.split(line, ":")
                computer = strings.trim(parts[1])
                break
    return Setting(
        day = clone(strings.split(time.format(time.now()), "T")[0]),
        computer = "{computer}, {os.platform()}",
        cpp = "{first_line("clang++", ["--version"])} with `-O2`",
        rust = "{first_line("rustc", ["--version"])} with `-C opt-level=3`",
        sayon = "{first_line(sayon, ["version"])} with `--release`"
    )

function build(benchmark: Benchmark, sayon: string, folder: string) -> Array<Build>
    name = clone(benchmark.name)
    source = filesystem.join(name, name)
    out = filesystem.join(folder, name)
    cpp = executable("{out}-cpp")
    rust = executable("{out}-rust")
    native = executable("{out}-sayon")
    must_run("clang++", ["-O2", "-std=c++20", "{source}.cpp", "-o", clone(cpp)])
    must_run("rustc", ["-C", "opt-level=3", "-o", clone(rust), "{source}.rs"])
    must_run(sayon, ["build", "--release", "-q", "{source}.sayon", "-o", clone(native)])
    return [
        Build(language = "C++", program = cpp),
        Build(language = "Rust", program = rust),
        Build(language = "Sayon", program = native)
    ]

# Runs each build once, which also brings the programs into the disk cache
# and past any virus scan of a new file, and fails unless all three print
# the same.
function check(benchmark: Benchmark, builds: Array<Build>)
    expected = ""
    for build in builds
        output = strings.replace(must_run(build.program, [clone(benchmark.input)]), "\r\n", "\n")
        if build.language == "C++"
            expected = output
        elseif output != expected
            error("{benchmark.name} in {build.language} printed\n{output}\nbut in C++\n{expected}")

# The builds take turns, so that whatever else the computer does at the
# time falls on all of them alike.
function measure(benchmark: Benchmark, builds: Array<Build>, runs: integer) -> Array<Measured>
    results: Array<Measured> = []
    for build in builds
        times: Array<integer> = []
        memory: Array<integer> = []
        push(results, Measured(times = times, memory = memory, size = filesystem.size(build.program)))
    for _round in range(runs)
        for index in range(length(builds))
            done = os.run(builds[index].program, [clone(benchmark.input)])
            if done.status != 0
                error("{benchmark.name} in {builds[index].language} failed with status {done.status}")
            push(results[index].times, done.usage.processor_time.nanoseconds)
            push(results[index].memory, done.usage.peak_memory)
    return results

function sorted(values: Array<integer>) -> Array<integer>
    copy = clone(values)
    collections.sort(copy)
    return copy

function median(values: Array<integer>) -> integer
    ordered = sorted(values)
    return ordered[length(ordered) / 2]

function seconds(nanoseconds: integer) -> string
    return "{strings.decimal(float(nanoseconds) / 1000000000.0, 2)} s"

function megabytes(bytes: integer) -> string
    return "{strings.decimal(float(bytes) / 1048576.0, 1)} MB"

function kilobytes(bytes: integer) -> string
    return "{(bytes + 512) / 1024} KB"

# Sayon's value against the better of C++'s and Rust's, as a factor: below
# 1 is better.
function factor(values: Array<integer>) -> float
    best = values[0]
    if values[1] < best
        best = values[1]
    return float(values[2]) / float(best)

function times_text(value: float) -> string
    return "{strings.decimal(value, 2)}×"

# The medians of what `pick` takes from each build's runs.
function medians(measured: Array<Measured>, update pick) -> Array<integer>
    values: Array<integer> = []
    for each in measured
        push(values, median(pick(each)))
    return values

# A program's own table: each version's numbers side by side.
function program_table(row: Row, runs: integer, used: Setting) -> string
    times = medians(row.measured, function(each: Measured) return clone(each.times))
    memory = medians(row.measured, function(each: Measured) return clone(each.memory))
    ranges: Array<string> = []
    for each in row.measured
        ordered = sorted(each.times)
        push(ranges, "{strings.decimal(float(ordered[0]) / 1000000000.0, 2)} to {seconds(ordered[length(ordered) - 1])}")
    speed = factor(times)
    room = factor(memory)
    verdict = "Sayon took {times_text(speed)} the time of the faster of the other two"
    if speed < 1.0
        verdict = "Sayon was the fastest, in {times_text(speed)} the time of the faster of the other two"
    held = "held {times_text(room)} the memory of the leaner one"
    if room < 1.0
        held = "held the least memory, {times_text(room)} that of the leaner one"
    lines = [
        "| | C++ | Rust | Sayon |",
        "|---|---:|---:|---:|",
        "| Processor time, median | {seconds(times[0])} | {seconds(times[1])} | {seconds(times[2])} |",
        "| Fastest and slowest run | {ranges[0]} | {ranges[1]} | {ranges[2]} |",
        "| Peak memory, median | {megabytes(memory[0])} | {megabytes(memory[1])} | {megabytes(memory[2])} |",
        "| Executable | {kilobytes(row.measured[0].size)} | {kilobytes(row.measured[1].size)} | {kilobytes(row.measured[2].size)} |",
        "",
        "{verdict}, and {held}.",
        "",
        "Input {row.benchmark.input}, {runs} runs of each, measured on {used.day} on {used.computer}. C++: {used.cpp}. Rust: {used.rust}. Sayon: {used.sayon}."
    ]
    return strings.join(lines, "\n")

# Puts a program's table into its README, between the markers.
function write_table(name: string, table: string)
    path = filesystem.join(name, "README.md")
    readme = io.read_file(path)
    head = strings.split(readme, START)
    if length(head) != 2
        error("{path} has no `{START}` line for the results")
    tail = strings.split(head[1], END)
    if length(tail) != 2
        error("{path} has no `{END}` line after the results")
    io.write_file(path, "{head[0]}{START}\n\n{table}\n\n{END}{tail[1]}")

# A summary table of the medians of what `pick` takes from each build.
function summary(rows: Array<Row>, update pick, show) -> string
    lines = ["| Benchmark | Input | C++ | Rust | Sayon | Sayon against the better |", "|---|---:|---:|---:|---:|---:|"]
    for row in rows
        values = medians(row.measured, pick)
        name = clone(row.benchmark.name)
        push(lines, "| [{name}]({name}/README.md) | {row.benchmark.input} | {show(values[0])} | {show(values[1])} | {show(values[2])} | {times_text(factor(values))} |")
    return strings.join(lines, "\n")

function report(rows: Array<Row>, runs: integer, used: Setting) -> string
    lines = [
        "# Benchmark results",
        "",
        "Measured on {used.day} on {used.computer}.",
        "",
        "- C++: {used.cpp}",
        "- Rust: {used.rust}",
        "- Sayon: {used.sayon}",
        "",
        "Each number is the median of {runs} runs. Processor time adds up the time the program's threads ran, and the system's time on its behalf, so it barely changes with what else the computer is doing. Peak memory is the most the program held in memory at once. Each program's README has its own table, with the fastest and slowest runs and the size of each executable.",
        "",
        "## Processor time",
        "",
        summary(rows, function(each: Measured) return clone(each.times), seconds),
        "",
        "## Peak memory",
        "",
        summary(rows, function(each: Measured) return clone(each.memory), megabytes),
        ""
    ]
    return strings.join(lines, "\n")

function main()
    runs = 5
    chosen: Array<string> = []
    arguments = os.arguments()
    position = 0
    while position < length(arguments)
        if arguments[position] == "--runs" and position + 1 < length(arguments)
            runs = strings.parse_integer(arguments[position + 1])
            position += 2
        else
            push(chosen, clone(arguments[position]))
            position += 1
    sayon = "sayon"
    named = os.environment("SAYON")
    if typeof(named) == "string"
        sayon = named
    used = setting(sayon)
    folder = "build"
    if not filesystem.exists(folder)
        filesystem.create_directory(folder)
    rows: Array<Row> = []
    for benchmark in all_benchmarks()
        if length(chosen) > 0 and not contains(chosen, benchmark.name)
            continue
        print("{benchmark.name} ({benchmark.input})")
        builds = build(benchmark, sayon, folder)
        check(benchmark, builds)
        measured = measure(benchmark, builds, runs)
        for index in range(length(builds))
            print("  {builds[index].language}: {seconds(median(measured[index].times))}, {megabytes(median(measured[index].memory))}")
        finished = Row(benchmark = clone(benchmark), measured = measured)
        write_table(benchmark.name, program_table(finished, runs, used))
        push(rows, finished)
    if length(chosen) == 0
        text = report(rows, runs, used)
        io.write_file("results.md", text)
        print("")
        print(text)

function contains(names: Array<string>, name: string) -> boolean
    for each in names
        if each == name
            return true
    return false
