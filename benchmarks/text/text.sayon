# Text: format many lines into one string, split it back into lines, and
# look through them. String formatting, joining, splitting, and searching.

os = import("standard/os.sayon")
strings = import("standard/strings.sayon")

function main()
    total = 100000
    arguments = os.arguments()
    if length(arguments) > 0
        total = strings.parse_integer(arguments[0])
    lines: Array<string> = []
    state = 42
    for i in range(total)
        state = (state * 1103515245 + 12345) % 2147483648
        push(lines, "item {i}: {state / 65536}")
    text = strings.join(lines, "\n")
    sevens = 0
    characters = 0
    for line in strings.split(text, "\n")
        characters += length(line)
        if strings.contains(line, "7")
            sevens += 1
    print("{length(text)} characters, {characters} in lines, {sevens} lines with a 7")
