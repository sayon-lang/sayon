##
N-body: the Sun and the four gas giants, moved step by step by each
other's gravity, with the system's energy before and after. Floating
point math on an array of structures.
##

math = import("standard/math.sayon")
os = import("standard/os.sayon")
strings = import("standard/strings.sayon")

constant PI = 3.141592653589793
constant SOLAR_MASS = 4.0 * PI * PI
constant DAYS_PER_YEAR = 365.24

type Body = [x: float, y: float, z: float, vx: float, vy: float, vz: float, mass: float]

function planet(x: float, y: float, z: float, vx: float, vy: float, vz: float, mass: float) -> Body
    return Body(x = x, y = y, z = z, vx = vx * DAYS_PER_YEAR, vy = vy * DAYS_PER_YEAR, vz = vz * DAYS_PER_YEAR, mass = mass * SOLAR_MASS)

function solar_system() -> Array<Body>
    return [
        Body(x = 0.0, y = 0.0, z = 0.0, vx = 0.0, vy = 0.0, vz = 0.0, mass = SOLAR_MASS),
        planet(4.84143144246472090e+00, -1.16032004402742839e+00, -1.03622044471123109e-01, 1.66007664274403694e-03, 7.69901118419740425e-03, -6.90460016972063023e-05, 9.54791938424326609e-04),
        planet(8.34336671824457987e+00, 4.12479856412430479e+00, -4.03523417114321381e-01, -2.76742510726862411e-03, 4.99852801234917238e-03, 2.30417297573763929e-05, 2.85885980666130812e-04),
        planet(1.28943695621391310e+01, -1.51111514016986312e+01, -2.23307578892655734e-01, 2.96460137564761618e-03, 2.37847173959480950e-03, -2.96589568540237556e-05, 4.36624404335156298e-05),
        planet(1.53796971148509165e+01, -2.59193146099879641e+01, 1.79258772950371181e-01, 2.68067772490389322e-03, 1.62824170038242295e-03, -9.51592254519715870e-05, 5.15138902046611451e-05)
    ]

function offset_momentum(update bodies: Array<Body>)
    px = 0.0
    py = 0.0
    pz = 0.0
    for body in bodies
        px += body.vx * body.mass
        py += body.vy * body.mass
        pz += body.vz * body.mass
    bodies[0].vx = 0.0 - px / SOLAR_MASS
    bodies[0].vy = 0.0 - py / SOLAR_MASS
    bodies[0].vz = 0.0 - pz / SOLAR_MASS

function energy(bodies: Array<Body>) -> float
    total = 0.0
    count = length(bodies)
    for i in range(count)
        total += 0.5 * bodies[i].mass * (bodies[i].vx * bodies[i].vx + bodies[i].vy * bodies[i].vy + bodies[i].vz * bodies[i].vz)
        for j in range(i + 1, count)
            dx = bodies[i].x - bodies[j].x
            dy = bodies[i].y - bodies[j].y
            dz = bodies[i].z - bodies[j].z
            total -= bodies[i].mass * bodies[j].mass / math.sqrt(dx * dx + dy * dy + dz * dz)
    return total

function advance(update bodies: Array<Body>, dt: float)
    count = length(bodies)
    for i in range(count)
        for j in range(i + 1, count)
            dx = bodies[i].x - bodies[j].x
            dy = bodies[i].y - bodies[j].y
            dz = bodies[i].z - bodies[j].z
            distance2 = dx * dx + dy * dy + dz * dz
            magnitude = dt / (distance2 * math.sqrt(distance2))
            mass_i = bodies[i].mass * magnitude
            mass_j = bodies[j].mass * magnitude
            bodies[i].vx -= dx * mass_j
            bodies[i].vy -= dy * mass_j
            bodies[i].vz -= dz * mass_j
            bodies[j].vx += dx * mass_i
            bodies[j].vy += dy * mass_i
            bodies[j].vz += dz * mass_i
    for i in range(count)
        bodies[i].x += dt * bodies[i].vx
        bodies[i].y += dt * bodies[i].vy
        bodies[i].z += dt * bodies[i].vz

function main()
    steps = 1000
    arguments = os.arguments()
    if length(arguments) > 0
        steps = strings.parse_integer(arguments[0])
    bodies = solar_system()
    offset_momentum(bodies)
    print(strings.decimal(energy(bodies), 9))
    for _step in range(steps)
        advance(bodies, 0.01)
    print(strings.decimal(energy(bodies), 9))
